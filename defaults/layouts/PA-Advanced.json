{
  "id": "root",
  "cloned_from": {
    "name": "my-main",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "prodsovet",
            "props": {
              "role": "brand"
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "projects",
              "type": "block",
              "content": {
                "mod": "prodsovet",
                "props": {
                  "role": "projects"
                }
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 241
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "prodsovet",
            "props": {
              "role": "tabs"
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "prodsovet"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "my-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "prodsovet",
                        "props": {
                          "role": "changes"
                        }
                      }
                    },
                    {
                      "id": "github",
                      "type": "block",
                      "content": {
                        "mod": "prodsovet",
                        "props": {
                          "role": "github"
                        }
                      }
                    },
                    {
                      "id": "issues",
                      "type": "block",
                      "content": {
                        "mod": "prodsovet",
                        "props": {
                          "role": "issues"
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 294
              },
              "min": 280,
              "max": 900
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "prodsovet",
            "props": {
              "role": "status"
            }
          },
          "size": {
            "px": 20
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "paper",
    "dark": "graphite"
  },
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "toast": "prodsovet",
  "preview": "layouts/pa-advanced.png",
  "ui_font": "Avenir Next",
  "font": "JetBrains Mono",
  "font_size": 14
}
